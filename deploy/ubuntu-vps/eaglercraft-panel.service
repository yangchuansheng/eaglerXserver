[Unit]
Description=Eaglercraft server management panel
After=network-online.target eaglercraft-paper.service
Wants=network-online.target

[Service]
User=eaglercraft
Group=eaglercraft
WorkingDirectory=/opt/eaglercraft/web
EnvironmentFile=/etc/eaglercraft/eaglercraft.env
ExecStart=/usr/bin/python3 /opt/eaglercraft/script/http_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
